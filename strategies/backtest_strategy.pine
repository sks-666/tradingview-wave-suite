//
// 0x9 Wave Suite — Trend-Aligned Strategy (v2)
//
// Idea (the "higher-timeframe signal, lower-timeframe entry" approach):
//   1. TREND  : the higher timeframe decides the direction (HTF close vs HTF EMA 50, completed bars only).
//   2. ENTRY  : buy a momentum-wave cross up from a dip (slow wave <= -Entry level) while the trend is UP.
//   3. EXIT   : opposite wave cross at +Exit level, the trend flipping, or the ATR stop.
// Shorts mirror the rules and are OFF by default (they tested worse).
//
// Tested offline on Binance BTC/ETH 4h candles with the daily trend, 0.1% fee per side:
// profitable in-sample (2020-23) and out-of-sample (2024-26), with far smaller drawdowns than
// buy-and-hold, but with lower total return than holding in bull years. It LOST money on 1h charts
// and on SOL out-of-sample. See README. Research tool only — not financial advice.

//@version=6
strategy("0x9 Wave Suite Strategy", shorttitle = "0x9 WS Strategy", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 95,
     commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 2,
     process_orders_on_close = false, pyramiding = 0)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_TR = "Trend (higher timeframe)"
const string G_WT = "WaveTrend"
const string G_EN = "Entries / exits"
const string G_RK = "Risk"
const string G_DT = "Date range"

autoTf    = input.bool(true, "Auto trend timeframe", group = G_TR, tooltip = "Chart below 1h → 4h trend. Chart 1h to below 1D → daily trend. Daily chart → weekly trend.")
manualTf  = input.timeframe("D", "Manual trend timeframe", group = G_TR)
trendLen  = input.int(50, "Trend EMA length", minval = 2, group = G_TR)

wtChannel = input.int(9,  "Channel length",   minval = 1, group = G_WT)
wtAverage = input.int(12, "Average length",   minval = 1, group = G_WT)
wtSignal  = input.int(3,  "Slow wave length", minval = 1, group = G_WT)

entryLvl   = input.float(40, "Entry level (buy cross at or below −level)", minval = 0, group = G_EN)
exitLvl    = input.float(40, "Exit level (sell cross at or above +level)", minval = 0, group = G_EN)
exitOnFlip = input.bool(true, "Exit when the trend flips", group = G_EN)
allowShort = input.bool(false, "Allow shorts (mirror rules)", group = G_EN)

atrLen   = input.int(14, "ATR length", minval = 1, group = G_RK)
stopMult = input.float(2.0, "Stop loss (× ATR, 0 = off)", minval = 0, step = 0.1, group = G_RK)
tpMult   = input.float(0.0, "Take profit (× ATR, 0 = off)", minval = 0, step = 0.1, group = G_RK)

startTime = input.time(timestamp("2020-01-01T00:00:00"), "Start", group = G_DT)
endTime   = input.time(timestamp("2099-01-01T00:00:00"), "End",   group = G_DT)

// ───────────────────────────── Calculations ─────────────────────────────
waveTrend(float s, int chLen, int avgLen, int sigLen) =>
    esa = ta.ema(s, chLen)
    dev = ta.ema(math.abs(s - esa), chLen)
    ci  = dev == 0 ? 0.0 : (s - esa) / (0.015 * dev)
    w1  = ta.ema(ci, avgLen)
    w2  = ta.sma(w1, sigLen)
    [w1, w2]

autoTrendTf() =>
    s = timeframe.in_seconds()
    s < 3600 ? "240" : s < 86400 ? "D" : s < 604800 ? "W" : "M"

trendTf = autoTf ? autoTrendTf() : manualTf

// [1] + lookahead_on = last COMPLETED higher-timeframe bar, so the trend never repaints.
[hClose, hEma] = request.security(syminfo.tickerid, trendTf, [close[1], ta.ema(close, trendLen)[1]], lookahead = barmerge.lookahead_on)
trendUp = hClose > hEma
trendDn = hClose < hEma

[wt1, wt2] = waveTrend(hlc3, wtChannel, wtAverage, wtSignal)
crossUp = ta.crossover(wt1, wt2)
crossDn = ta.crossunder(wt1, wt2)
atr = ta.atr(atrLen)

inDate = time >= startTime and time <= endTime

longEntry  = inDate and crossUp and wt2 <= -entryLvl and trendUp
shortEntry = inDate and allowShort and crossDn and wt2 >= entryLvl and trendDn
longExit   = (crossDn and wt2 >= exitLvl) or (exitOnFlip and not trendUp)
shortExit  = (crossUp and wt2 <= -exitLvl) or (exitOnFlip and not trendDn)

// ───────────────────────────── Orders ─────────────────────────────
flat = strategy.position_size == 0
// Stop and target are fixed on the signal bar, measured from its close, and placed together with the entry.
longStop  = stopMult > 0 ? close - stopMult * atr : na
longTp    = tpMult > 0 ? close + tpMult * atr : na
shortStop = stopMult > 0 ? close + stopMult * atr : na
shortTp   = tpMult > 0 ? close - tpMult * atr : na

if flat and longEntry
    strategy.entry("Long", strategy.long)
    if stopMult > 0 or tpMult > 0
        strategy.exit("Long stop/target", "Long", stop = longStop, limit = longTp)
else if flat and shortEntry
    strategy.entry("Short", strategy.short)
    if stopMult > 0 or tpMult > 0
        strategy.exit("Short stop/target", "Short", stop = shortStop, limit = shortTp)

if strategy.position_size > 0 and longExit
    strategy.close("Long", comment = "Exit long")
if strategy.position_size < 0 and shortExit
    strategy.close("Short", comment = "Exit short")

// ───────────────────────────── Visuals ─────────────────────────────
plot(hEma, "Trend EMA (higher timeframe)", color = trendUp ? #16a34a : #dc2626, linewidth = 2)
bgcolor(trendUp ? color.new(#16a34a, 95) : trendDn ? color.new(#dc2626, 95) : na, title = "Trend background")
plotshape(longEntry and flat,  "Buy signal",  shape.triangleup,   location.belowbar, #16a34a, size = size.small)
plotshape(shortEntry and flat, "Sell signal", shape.triangledown, location.abovebar, #dc2626, size = size.small)
